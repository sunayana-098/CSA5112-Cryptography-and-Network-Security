#include <stdio.h>
#include <string.h>
#include <openssl/des.h>

int main(void) {
    DES_cblock k1 = {1,2,3,4,5,6,7,8};
    DES_cblock k2 = {9,10,11,12,13,14,15,16};
    DES_cblock k3 = {17,18,19,20,21,22,23,24};
    DES_key_schedule s1, s2, s3;
    DES_cblock iv = {0,0,0,0,0,0,0,0};
    unsigned char input[256], output[264];
    int len, padded, i;

    DES_set_key_unchecked(&k1, &s1);
    DES_set_key_unchecked(&k2, &s2);
    DES_set_key_unchecked(&k3, &s3);

    printf("Enter plaintext: ");
    if (!fgets((char *)input, sizeof(input), stdin))
        return 1;

    len = (int)strlen((char *)input);
    if (len > 0 && input[len - 1] == '\n')
        len--;

    padded = ((len / 8) + 1) * 8;

    for (i = len; i < padded; i++)
        input[i] = (unsigned char)(padded - len);

    DES_ede3_cbc_encrypt(input, output, padded,
                         &s1, &s2, &s3, &iv, DES_ENCRYPT);

    printf("Ciphertext: ");
    for (i = 0; i < padded; i++)
        printf("%02X", output[i]);

    printf("\n");
    return 0;
}

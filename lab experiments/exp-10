
#include <stdio.h>
#include <string.h>
#include <ctype.h>

char m[5][5] = {
    {'M','F','H','I','K'},
    {'U','N','O','P','Q'},
    {'Z','V','W','X','Y'},
    {'E','L','A','R','G'},
    {'D','S','T','B','C'}
};

void find(char ch, int *r, int *c) {
    int i, j;
    if (ch == 'J') ch = 'I';

    for (i = 0; i < 5; i++)
        for (j = 0; j < 5; j++)
            if (m[i][j] == ch) {
                *r = i;
                *c = j;
                return;
            }
}

int main() {
    char text[200], p[400];
    int i, n = 0, r1, c1, r2, c2, t;

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    for (i = 0; text[i]; i++)
        if (isalpha((unsigned char)text[i])) {
            char ch = toupper((unsigned char)text[i]);
            p[n++] = (ch == 'J') ? 'I' : ch;
        }

    p[n] = '\0';

    i = 0;
    while (i < n) {
        if (i + 1 >= n) {
            p[n++] = 'X';
            p[n] = '\0';
        } else if (p[i] == p[i+1]) {
            memmove(p+i+2, p+i+1, n-i);
            p[i+1] = 'X';
            n++;
        }
        i += 2;
    }

    printf("Encrypted text: ");

    for (i = 0; i < n; i += 2) {
        find(p[i], &r1, &c1);
        find(p[i+1], &r2, &c2);

        if (r1 == r2) {
            c1 = (c1 + 1) % 5;
            c2 = (c2 + 1) % 5;
        } else if (c1 == c2) {
            r1 = (r1 + 1) % 5;
            r2 = (r2 + 1) % 5;
        } else {
            t = c1;
            c1 = c2;
            c2 = t;
        }

        printf("%c%c", m[r1][c1], m[r2][c2]);
    }

    printf("\n");
    return 0;
}


#include <stdio.h>
#include <string.h>

int P10[]={3,5,2,7,4,10,1,9,8,6};
int P8[]={6,3,7,4,8,5,10,9};
int IP[]={2,6,3,1,4,8,5,7};
int IPI[]={4,1,3,5,7,2,8,6};
int EP[]={4,1,2,3,2,3,4,1};
int P4[]={2,4,3,1};

int S0[4][4]={
{1,0,3,2},{3,2,1,0},
{0,2,1,3},{3,1,3,2}
};
int S1[4][4]={
{0,1,2,3},{2,0,1,3},
{3,0,1,0},{2,1,0,3}
};

int perm(int x,int *p,int n,int bits){
    int r=0;
    for(int i=0;i<n;i++)
        r=(r<<1)|((x>>(bits-p[i]))&1);
    return r;
}

int rotate5(int x,int n){
    return ((x<<n)|(x>>(5-n)))&31;
}

void keys(int k,int *k1,int *k2){
    int x=perm(k,P10,10,10);
    int l=x>>5,r=x&31;
    l=rotate5(l,1);
    r=rotate5(r,1);
    *k1=perm((l<<5)|r,P8,8,10);
    l=rotate5(l,2);
    r=rotate5(r,2);
    *k2=perm((l<<5)|r,P8,8,10);
}

int sb(int x,int s[4][4]){
    int row=((x&8)>>2)|(x&1);
    int col=(x>>1)&3;
    return s[row][col];
}

int fk(int x,int k){
    int l=x>>4,r=x&15;
    int t=perm(r,EP,8,4)^k;
    int y=(sb(t>>4,S0)<<2)|sb(t&15,S1);
    return ((l^perm(y,P4,4,4))<<4)|r;
}

int sd(int x,int k,int decrypt){
    int k1,k2;
    keys(k,&k1,&k2);
    if(decrypt){
        int t=k1;k1=k2;k2=t;
    }
    x=perm(x,IP,8,8);
    x=fk(x,k1);
    x=((x&15)<<4)|(x>>4);
    x=fk(x,k2);
    return perm(x,IPI,8,8);
}

int main(){
    int key,iv,mode,n;
    unsigned char p[100],c[100],d[100];
    char input[200];

    printf("Enter key (decimal 0-1023): ");
    scanf("%d",&key);
    printf("Enter IV (decimal 0-255): ");
    scanf("%d",&iv);

    printf("Enter mode (1-ECB 2-CBC 3-CFB): ");
    scanf("%d",&mode);

    printf("Enter plaintext in hexadecimal: ");
    scanf("%199s",input);

    n=strlen(input)/2;
    for(int i=0;i<n;i++)
        sscanf(input+2*i,"%2hhx",&p[i]);

    // Always add 0x80 followed by zero padding
    p[n++]=0x80;
    while(n%1!=0) p[n++]=0;

    int prev=iv;

    for(int i=0;i<n;i++){
        if(mode==1)
            c[i]=sd(p[i],key,0);

        else if(mode==2){
            c[i]=sd(p[i]^prev,key,0);
            prev=c[i];
        }
        else if(mode==3){
            c[i]=p[i]^sd(prev,key,0);
            prev=c[i];
        }
    }

    printf("Encrypted: ");
    for(int i=0;i<n;i++) printf("%02X ",c[i]);

    prev=iv;

    for(int i=0;i<n;i++){
        if(mode==1)
            d[i]=sd(c[i],key,1);

        else if(mode==2){
            d[i]=sd(c[i],key,1)^prev;
            prev=c[i];
        }
        else if(mode==3){
            d[i]=c[i]^sd(prev,key,0);
            prev=c[i];
        }
    }

    printf("\nDecrypted: ");
    for(int i=0;i<n;i++) printf("%02X ",d[i]);

    printf("\n");
    return 0;
}

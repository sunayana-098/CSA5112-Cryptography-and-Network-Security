
#include <stdio.h>
#include <math.h>

int main() {
    double bits = 0;
    int i;

    for (i = 1; i <= 25; i++)
        bits += log2(i);

    printf("Total keys = 25!\n");
    printf("Approximate power of 2: 2^%.2f\n", bits);

    printf("Effectively unique keys = 25! / 4\n");
    printf("Approximate power of 2: 2^%.2f\n", bits - 2);

    return 0;
}


#include <stdio.h>
#include <string.h>
#include <ctype.h>

char m[5][5];

void create(char key[]) {
    int used[26] = {0}, i, n = 0;
    char s[26], ch;

    for (i = 0; key[i]; i++) {
        ch = toupper((unsigned char)key[i]);
        if (ch == 'J') ch = 'I';
        if (ch >= 'A' && ch <= 'Z' && !used[ch-'A']) {
            s[n++] = ch;
            used[ch-'A'] = 1;
        }
    }

    for (ch = 'A'; ch <= 'Z'; ch++) {
        if (ch == 'J') continue;
        if (!used[ch-'A']) s[n++] = ch;
    }

    for (i = 0; i < 25; i++)
        m[i/5][i%5] = s[i];
}

void find(char ch, int *r, int *c) {
    int i, j;
    if (ch == 'J') ch = 'I';

    for (i = 0; i < 5; i++)
        for (j = 0; j < 5; j++)
            if (m[i][j] == ch) {
                *r = i;
                *c = j;
                return;
            }
}

int main() {
    char key[100], text[500], out[500];
    int i, n = 0, r1, c1, r2, c2, t;

    printf("Enter key: ");
    scanf("%99s", key);
    create(key);

    printf("Enter ciphertext: ");
    scanf(" %499[^\n]", text);

    for (i = 0; text[i]; i++)
        if (isalpha((unsigned char)text[i]))
            out[n++] = toupper((unsigned char)text[i]);
    out[n] = '\0';

    if (n % 2 != 0) {
        printf("Ciphertext must contain an even number of letters.\n");
        return 0;
    }

    for (i = 0; i < n; i += 2) {
        find(out[i], &r1, &c1);
        find(out[i+1], &r2, &c2);

        if (r1 == r2) {
            c1 = (c1 + 4) % 5;
            c2 = (c2 + 4) % 5;
        } else if (c1 == c2) {
            r1 = (r1 + 4) % 5;
            r2 = (r2 + 4) % 5;
        } else {
            t = c1;
            c1 = c2;
            c2 = t;
        }

        out[i] = m[r1][c1];
        out[i+1] = m[r2][c2];
    }

    printf("Decrypted text: %s\n", out);
    return 0;
}

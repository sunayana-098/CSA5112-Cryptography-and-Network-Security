
#include <stdio.h>

int gcd(int a,int b){
    while(b){
        int t=b;
        b=a%b;
        a=t;
    }
    return a;
}

int main(){
    int n=3599,e=31,p=0,q=0;
    int phi,d;

    for(int i=2;i*i<=n;i++){
        if(n%i==0){
            p=i;
            q=n/i;
            break;
        }
    }

    phi=(p-1)*(q-1);

    for(d=1;d<phi;d++){
        if((e*d)%phi==1)
            break;
    }

    printf("Public Key: (%d,%d)\n",e,n);
    printf("p = %d\n",p);
    printf("q = %d\n",q);
    printf("Phi(n) = %d\n",phi);
    printf("Private Key d = %d\n",d);

    return 0;
}

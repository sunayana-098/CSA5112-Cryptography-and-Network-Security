
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char p[300], c[300];
    int K[2][2] = {{9,4},{5,7}};
    int inv = 23, i, n, a, b;

    printf("Enter plaintext: ");
    fgets(p, sizeof(p), stdin);

    n = 0;
    for (i = 0; p[i]; i++)
        if (isalpha((unsigned char)p[i]))
            p[n++] = toupper((unsigned char)p[i]);
    p[n] = '\0';

    if (n % 2) p[n++] = 'X';
    p[n] = '\0';

    for (i = 0; i < n; i += 2) {
        a = p[i] - 'A';
        b = p[i+1] - 'A';
        c[i]   = (9*a + 4*b) % 26 + 'A';
        c[i+1] = (5*a + 7*b) % 26 + 'A';
    }
    c[n] = '\0';

    printf("Ciphertext: %s\n", c);

    printf("Decrypted text: ");
    for (i = 0; i < n; i += 2) {
        a = c[i] - 'A';
        b = c[i+1] - 'A';
        printf("%c%c",
            ((inv*(7*a - 4*b) % 26 + 26) % 26) + 'A',
            ((inv*(-5*a + 9*b) % 26 + 26) % 26) + 'A');
    }

    printf("\n");
    return 0;
}

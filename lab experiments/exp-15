
#include <stdio.h>
#include <string.h>
#include <ctype.h>

double freq[26] = {
    8.167,1.492,2.782,4.253,12.702,2.228,
    2.015,6.094,6.966,0.153,0.772,4.025,
    2.406,6.749,7.507,1.929,0.095,5.987,
    6.327,9.056,2.758,0.978,2.360,0.150,
    1.974,0.074
};

int main() {
    char text[1000], plain[1000];
    double score[26], count[26];
    int shift, i, j, n, top, best;
    double temp;

    printf("Enter ciphertext: ");
    fgets(text, sizeof(text), stdin);

    printf("How many top plaintexts? ");
    scanf("%d", &top);
    if (top < 1) top = 1;
    if (top > 26) top = 26;

    for (shift = 0; shift < 26; shift++) {
        memset(count, 0, sizeof(count));
        n = 0;

        for (i = 0; text[i]; i++) {
            if (isalpha((unsigned char)text[i])) {
                int x = (toupper((unsigned char)text[i])-'A'-shift+26)%26;
                count[x]++;
                n++;
            }
        }

        score[shift] = 0;
        for (i = 0; i < 26; i++) {
            double expected = freq[i] * n / 100.0;
            if (expected > 0) {
                double diff = count[i] - expected;
                score[shift] += diff * diff / expected;
            }
        }
    }

    printf("\nMost likely plaintexts:\n");
    for (j = 0; j < top; j++) {
        best = -1;
        for (shift = 0; shift < 26; shift++)
            if (score[shift] >= 0 &&
                (best == -1 || score[shift] < score[best]))
                best = shift;

        printf("Shift %2d: ", best);
        for (i = 0; text[i]; i++) {
            if (isalpha((unsigned char)text[i])) {
                char base = isupper((unsigned char)text[i]) ? 'A' : 'a';
                putchar((text[i] - base - best + 26) % 26 + base);
            } else {
                putchar(text[i]);
            }
        }

        printf("\n");
        score[best] = -1;
    }

    return 0;
}

#include <stdio.h>
#include <string.h>
#include <ctype.h>

int gcd(int a, int b) {
    while (b) {
        int t = b;
        b = a % b;
        a = t;
    }
    return a;
}

int main(void) {
    char p[200];
    int a, b;

    printf("Enter plaintext: ");
    fgets(p, sizeof(p), stdin);

    printf("Enter a and b: ");
    scanf("%d%d", &a, &b);

    a = (a % 26 + 26) % 26;
    b = (b % 26 + 26) % 26;

    if (gcd(a, 26) != 1) {
        printf("Invalid key: a must be coprime with 26\n");
        return 0;
    }

    printf("Ciphertext: ");
    for (int i = 0; p[i] && p[i] != '\n'; i++) {
        if (isalpha((unsigned char)p[i])) {
            int x = toupper((unsigned char)p[i]) - 'A';
            printf("%c", (a * x + b) % 26 + 'A');
        } else {
            printf("%c", p[i]);
        }
    }
    printf("\n");
    return 0;
}

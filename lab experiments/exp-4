#include <stdio.h>
#include <ctype.h>
int gcd(int a, int b) {
    while (b != 0) {
        int t = b;
        b = a % b;
        a = t;
    }
    return a;
}
int inverse(int a) {
    int i;
    for (i = 1; i < 26; i++)
        if ((a * i) % 26 == 1)
            return i;
    return -1;
}
int main() {
    char text[100];
    int a, b, i, x, inv;
    printf("Enter value of a: ");
    scanf("%d", &a);
    printf("Enter value of b: ");
    scanf("%d", &b);
    if (gcd(a, 26) != 1) {
        printf("Invalid value of a!\n");
        return 0;
    }
    printf("Enter plaintext: ");
    scanf(" %[^\n]", text);
    for (i = 0; text[i]; i++) {
        if (isalpha(text[i])) {
            x = toupper(text[i]) - 'A';
            text[i] = (a * x + b) % 26 + 'A';
        }
    }
    printf("Encrypted text: %s\n", text);
    inv = inverse(a);
    printf("Enter ciphertext: ");
    scanf(" %[^\n]", text);
    for (i = 0; text[i]; i++) {
        if (isalpha(text[i])) {
            x = toupper(text[i]) - 'A';
            text[i] = (inv * (x - b + 26)) % 26 + 'A';
        }
    }
    printf("Decrypted text: %s\n", text);
    return 0;
}

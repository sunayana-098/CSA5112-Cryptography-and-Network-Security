#include <stdio.h>
#include <ctype.h>
#include <string.h>

double freq[26] = {
    8.167,1.492,2.782,4.253,12.702,2.228,2.015,
    6.094,6.966,0.153,0.772,4.025,2.406,6.749,
    7.507,1.929,0.095,5.987,6.327,9.056,2.758,
    0.978,2.360,0.150,1.974,0.074
};

int main() {
    char s[1000];
    double score[26], count[26];
    int top, i, j, k, n, best;

    printf("Enter ciphertext: ");
    fgets(s, sizeof(s), stdin);
    printf("Enter top candidates (1-26): ");
    scanf("%d", &top);

    if (top < 1) top = 1;
    if (top > 26) top = 26;

    for (k = 0; k < 26; k++) {
        memset(count, 0, sizeof(count));
        n = 0;

        for (i = 0; s[i]; i++) {
            if (isalpha((unsigned char)s[i])) {
                j = (toupper((unsigned char)s[i])-'A'-k+26)%26;
                count[j]++;
                n++;
            }
        }

        score[k] = 0;
        for (i = 0; i < 26; i++) {
            double e = freq[i] * n / 100.0;
            if (e > 0) {
                double d = count[i] - e;
                score[k] += d*d/e;
            }
        }
    }

    for (j = 0; j < top; j++) {
        best = -1;
        for (k = 0; k < 26; k++)
            if (score[k] >= 0 &&
                (best == -1 || score[k] < score[best]))
                best = k;

        printf("Candidate %d: ", j+1);
        for (i = 0; s[i]; i++) {
            if (isalpha((unsigned char)s[i])) {
                char base = isupper((unsigned char)s[i]) ? 'A' : 'a';
                putchar((s[i]-base-best+26)%26+base);
            } else putchar(s[i]);
        }
        printf("\n");
        score[best] = -1;
    }
    return 0;
}

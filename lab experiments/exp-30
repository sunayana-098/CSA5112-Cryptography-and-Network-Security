
#include <stdio.h>

int encrypt(int x,int key){
    return (5*x+key)%256;
}

int main(){
    int key=17;
    int X=42;

    int T=encrypt(X,key);

    int Y=X^T;

    int C1=encrypt(X,key);
    int C2=encrypt(Y^C1,key);

    printf("Secret Key = %d\n",key);
    printf("Message X = %d\n",X);

    printf("\nOne Block CBC-MAC = %d\n",T);

    printf("Second Block (X XOR T) = %d\n",Y);

    printf("\nForged Two Block Message:\n");
    printf("%d || %d\n",X,Y);

    printf("Forged CBC-MAC = %d\n",C2);

    if(T==C2)
        printf("\nForgery Successful!\n");

    return 0;
}

#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main(void) {
    char text[1000], result[26][1000];
    double score[26];
    double freq[26] = {
        8.17,1.49,2.78,4.25,12.70,2.23,2.02,6.09,6.97,
        0.15,0.77,4.03,2.41,6.75,7.51,1.93,0.10,5.99,
        6.33,9.06,2.76,0.98,2.36,0.15,1.97,0.07
    };

    printf("Enter ciphertext: ");
    fgets(text, sizeof(text), stdin);

    int n = strlen(text);
    for (int k = 0; k < 26; k++) {
        int count[26] = {0}, letters = 0;
        double s = 0;

        for (int i = 0; i < n; i++) {
            if (isalpha((unsigned char)text[i])) {
                int c = toupper((unsigned char)text[i]) - 'A';
                int p = (c - k + 26) % 26;
                result[k][i] = p + 'A';
                count[p]++;
                letters++;
            } else {
                result[k][i] = text[i];
            }
        }
        result[k][n] = '\0';

        for (int j = 0; j < 26; j++)
            if (letters)
                s += count[j] * freq[j] / letters;

        score[k] = s;
    }

    printf("\nTop 10 possible plaintexts:\n");

    for (int r = 0; r < 10; r++) {
        int best = -1;
        for (int k = 0; k < 26; k++)
            if (score[k] >= 0 &&
                (best == -1 || score[k] > score[best]))
                best = k;

        printf("Key %d: %s\n", best, result[best]);
        score[best] = -1;
    }

    return 0;
}

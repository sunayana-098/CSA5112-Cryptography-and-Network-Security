#include <stdio.h>
#include <string.h>
#include <ctype.h>

int mod(int x) {
    return (x % 26 + 26) % 26;
}

int inverse(int x) {
    for (int i = 1; i < 26; i++)
        if (mod(x * i) == 1) return i;
    return -1;
}

int main(void) {
    char p[5], c[5];
    int P[2][2], C[2][2], K[2][2];
    int det, inv;

    printf("Enter two plaintext pairs (4 letters): ");
    scanf("%4s", p);
    printf("Enter corresponding ciphertext pairs (4 letters): ");
    scanf("%4s", c);

    for (int i = 0; i < 4; i++) {
        if (!isalpha((unsigned char)p[i]) ||
            !isalpha((unsigned char)c[i])) {
            printf("Letters only\n");
            return 1;
        }
    }

    for (int j = 0; j < 2; j++) {
        P[0][j] = toupper(p[2*j]) - 'A';
        P[1][j] = toupper(p[2*j+1]) - 'A';
        C[0][j] = toupper(c[2*j]) - 'A';
        C[1][j] = toupper(c[2*j+1]) - 'A';
    }

    det = mod(P[0][0]*P[1][1] - P[0][1]*P[1][0]);
    inv = inverse(det);

    if (inv == -1) {
        printf("Plaintext matrix has no inverse modulo 26\n");
        return 1;
    }

    int adj[2][2] = {
        {P[1][1], -P[0][1]},
        {-P[1][0], P[0][0]}
    };

    for (int i = 0; i < 2; i++)
        for (int j = 0; j < 2; j++)
            adj[i][j] = mod(adj[i][j] * inv);

    for (int i = 0; i < 2; i++)
        for (int j = 0; j < 2; j++) {
            K[i][j] = 0;
            for (int k = 0; k < 2; k++)
                K[i][j] = mod(K[i][j] + C[i][k] * adj[k][j]);
        }

    printf("Recovered Hill key:\n");
    for (int i = 0; i < 2; i++)
        printf("%d %d\n", K[i][0], K[i][1]);

    return 0;
}

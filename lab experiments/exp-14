
#include <stdio.h>
#include <ctype.h>
#include <string.h>

int main() {
    char p[200], c[200], target[] = "CASHNOTNEEDED";
    int key[] = {9,0,1,7,23,15,21,14,11,11,2,8,9};
    int newkey[13], i, n = 0;

    printf("Enter plaintext: ");
    fgets(p, sizeof(p), stdin);

    for (i = 0; p[i]; i++)
        if (isalpha((unsigned char)p[i]))
            p[n++] = toupper((unsigned char)p[i]);

    p[n] = '\0';

    if (n != 13) {
        printf("Please enter exactly 13 letters, ignoring spaces.\n");
        return 0;
    }

    for (i = 0; i < n; i++)
        c[i] = (p[i] - 'A' + key[i]) % 26 + 'A';
    c[n] = '\0';

    printf("Ciphertext: %s\n", c);

    printf("New key for target CASH NOT NEEDED: ");
    for (i = 0; i < n; i++) {
        newkey[i] = (c[i] - target[i] + 26) % 26;
        printf("%d ", newkey[i]);
    }

    printf("\n");
    return 0;
}

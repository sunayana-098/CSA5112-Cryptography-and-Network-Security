#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include <ctype.h>

int main(void) {
    char p[200], c[200], d[200];
    int key[200], n = 0;

    srand((unsigned)time(NULL));

    printf("Enter plaintext: ");
    fgets(p, sizeof(p), stdin);

    for (int i = 0; p[i] && p[i] != '\n'; i++) {
        if (isalpha((unsigned char)p[i])) {
            int x = toupper((unsigned char)p[i]) - 'A';
            key[n] = rand() % 26;
            c[n] = (x + key[n]) % 26 + 'A';
            d[n] = (c[n] - 'A' - key[n] + 26) % 26 + 'A';
            n++;
        }
    }

    c[n] = d[n] = '\0';

    printf("Random key: ");
    for (int i = 0; i < n; i++)
        printf("%d ", key[i]);

    printf("\nCiphertext: %s\n", c);
    printf("Decrypted text: %s\n", d);

    return 0;
}

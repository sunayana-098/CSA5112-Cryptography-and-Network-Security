#include <stdio.h>
#include <string.h>
#include <ctype.h>
int main() {
    char text[100], key[100];
    int i, j = 0, n;
    printf("Enter plaintext: ");
    scanf(" %[^\n]", text);
    printf("Enter key: ");
    scanf("%s", key);
    n = strlen(key);
    for (i = 0; text[i]; i++) {
        if (isalpha(text[i])) {
            text[i] = toupper(text[i]);
            text[i] = (text[i] - 'A' +
                       toupper(key[j % n]) - 'A') % 26 + 'A';
            j++;
        }
    }
    printf("Encrypted text: %s\n", text);
    printf("Enter ciphertext: ");
    scanf(" %[^\n]", text);
    j = 0;
    for (i = 0; text[i]; i++) {
        if (isalpha(text[i])) {
            text[i] = (toupper(text[i]) - 'A' -
                       (toupper(key[j % n]) - 'A') + 26) % 26 + 'A';
            j++;
        }
    }
    printf("Decrypted text: %s\n", text);
    return 0;
}
